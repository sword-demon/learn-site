{
    "name": "learn-site/api",
    "type": "project",
    "description": "Webman 2.2 API for the personal learning site",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "monolog/monolog": "^2.0",
        "robmorgan/phinx": "^0.16",
        "webman/push": "^1.0",
        "webman/redis": "^2.1",
        "webman/redis-queue": "~2.1",
        "webman/think-orm": "^2.1",
        "workerman/crontab": "^1.0",
        "workerman/webman-framework": "^2.2",
        "workerman/workerman": "^5.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-event": "For better Workerman performance"
    },
    "autoload": {
        "psr-4": {
            "": "./",
            "app\\": "./app",
            "App\\": "./app",
            "app\\View\\Components\\": "./app/view/components"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-package-install": [
            "support\\Plugin::install"
        ],
        "post-package-update": [
            "support\\Plugin::install"
        ],
        "pre-package-uninstall": [
            "support\\Plugin::uninstall"
        ],
        "start": "php start.php start",
        "stop": "php start.php stop",
        "reload": "php start.php reload",
        "migrate": "php vendor/bin/phinx migrate",
        "seed": "php vendor/bin/phinx seed:run",
        "lint": "phpcs --standard=PSR12 app/ tests/",
        "stan": "phpstan analyse --level=6 app/",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
