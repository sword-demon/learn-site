# Local environment template. Copy to .env and fill in real values.
# Never commit .env; this file lists every variable the stack reads.
#
# Section guide:
#   MySQL / Redis    — database and cache credentials
#   Tokens           — TTL knobs (in seconds)
#   Captcha          — TTL in seconds (FR-091: 120)
#   Super admin      — first account created by SuperAdminSeeder
#   Fake payment     — local-only payment adapter flag (FR-094)

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=learn_site
MYSQL_USER=learn_site
MYSQL_PASSWORD=change-me-app

# ----- Redis (no host port exposure by default) -----
REDIS_HOST=redis
REDIS_PORT=6379

# ----- Token TTLs (FR-092) -----
ACCESS_TOKEN_TTL=900            # 15 minutes
REFRESH_TOKEN_TTL=604800        # 7 days
CAPTCHA_TTL=120                 # 2 minutes

# ----- App -----
APP_ENV=production
TZ=UTC
WEBMAN_WORKERS=2
API_PORT=8787
WEB_PORT=8080
ADMIN_PORT=8081

# ----- Super admin (seeded on first boot) -----
# Note: not an 11-digit phone number; FR-003 forbids phone-shaped staff accounts.
SUPER_ADMIN_ACCOUNT=admin
SUPER_ADMIN_PASSWORD=change-me-now

# ----- Fake payment (FR-094, MVP-only) -----
FAKE_PAYMENT=1
FAKE_PAYMENT_DELAY_MS=3000